# ============================================================
# Configuracao do traqueamento - copie este arquivo para ".env"
# e preencha com seus valores reais. NUNCA comite o .env.
# ============================================================

# --- Meta (Facebook) Pixel + Conversions API ---
# ID do Pixel (numerico). Encontra em: Gerenciador de Eventos > Fontes de dados
META_PIXEL_ID=000000000000000

# Token de acesso da Conversions API (CAPI). Deixe vazio ate ter o token real;
# enquanto vazio, a CAPI fica inativa (o Pixel no navegador continua funcionando).
# Gerenciador de Eventos > seu Pixel > Configuracoes > Conversions API > Gerar token de acesso
META_CAPI_ACCESS_TOKEN=

# Versao da Graph API
META_GRAPH_API_VERSION=v21.0

# Codigo de teste (opcional, so para validar eventos na aba "Testar eventos").
# Deixe vazio em producao.
META_TEST_EVENT_CODE=

# --- Google Analytics 4 ---
# Measurement ID (formato G-XXXXXXXXXX). GA4 > Admin > Fluxos de dados
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Servidor ---
PORT=3000
